default_platform(:ios)

platform :ios do
  desc "Manuel Versiyon ile App Store Production Dağıtımı"
  lane :release do
    # App Store Connect API bağlantısı
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_BASE64_KEY"],
      in_house: false
    )

    # Sertifikaları sadece oku ve CI sunucusuna yükle
    match(type: "appstore", readonly: true)

    # Hazırladığınız .ipa dosyasını doğrudan App Store Connect'e yükler
    # xcrun altool komutunuzun yaptığı işi Fastlane API anahtarı ile güvenli yapar
    upload_to_app_store(
      api_key: api_key,
      ipa: "../build/ios/ipa/fis_app.ipa", # Kendi ipa adınıza göre güncelleyin veya direkt klasörü gösterin
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      phased_release: true
    )
  end
end