default_platform(:ios)

platform :ios do
  desc "Manuel Versiyon ile App Store Production Dağıtımı"
  lane :release do
    setup_ci # CI ortamını hazırlar

    # App Store Connect API bağlantısı
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_BASE64_KEY"],
      is_key_content_base64: true,
      in_house: false
    )

    # Sertifikaları sadece oku ve CI sunucusuna yükle
    match(type: "appstore", readonly: true)

    # HATA VEREN build_app ADIMINI SİLDİK!
    # Doğrudan Flutter'ın ürettiği hazır .ipa dosyasını App Store Connect'e gönderiyoruz
    upload_to_app_store(
      api_key: api_key,
      ipa: "../build/ios/ipa/Runner.ipa", # Flutter'ın ürettiği varsayılan ipa yolu (Eğer ipa adınız farklıysa güncelleyebilirsiniz)
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      phased_release: true
    )
  end
end
